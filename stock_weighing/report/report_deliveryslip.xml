<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
        <xpath
            expr="//span[@t-out='format_number(move.quantity)']"
            position="attributes"
        >
            <attribute name="t-if">not move.picked or move.state == 'done'</attribute>
        </xpath>
        <xpath expr="//span[@t-out='format_number(move.quantity)']" position="before">
            <span
                t-if="move.picked and move.state != 'done'"
                class="text-nowrap"
                t-out="format_number(move.captured_quantity)"
            />
        </xpath>
    </template>
</odoo>
