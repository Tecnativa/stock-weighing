<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="weighing_wizard_form_view" model="ir.ui.view">
        <field name="model">weighing.wizard</field>
        <field name="arch" type="xml">
            <form create="false" string="Record Weight">
                <field name="selected_move_line_id" invisible="1" />
                <field name="move_id" invisible="1" />
                <field name="product_id" invisible="1" />
                <field name="available_lot_ids" invisible="1" />
                <field name="available_result_package_ids" invisible="1" />
                <field name="has_weight" invisible="1" />
                <sheet>
                    <div
                        class="d-flex align-items-center gap-2 mb-3"
                        invisible="not show_quant or wizard_state == 'weight'"
                    >
                        <field
                            name="quant_id"
                            class="form-control-lg ps-0 flex-grow-1"
                            placeholder="Select source stock..."
                            domain="[('product_id', '=', product_id), ('location_id', 'child_of', location_id)]"
                            context="{
                                'default_product_id': product_id,
                                'search_view_ref': 'stock.quant_search_view',
                                'list_view_ref': 'stock.view_stock_quant_tree_simple',
                                'form_view_ref': 'stock.view_stock_quant_form',
                                'readonly_form': True
                            }"
                            options="{'no_create': True, 'no_open': True}"
                            nolabel="1"
                        />
                        <button
                            name="action_clear_quant"
                            type="object"
                            class="btn btn-primary o_weighing_clear_quant_btn"
                            icon="delete"
                            title="Clear source stock"
                            aria-label="Clear source stock"
                            invisible="not quant_id"
                        />
                    </div>
                    <group
                        groups="stock.group_production_lot"
                        col="1"
                        invisible="quant_id != False"
                    >
                        <field
                            name="lot_id"
                            class="form-control-lg pl-0"
                            placeholder="Select lot..."
                            invisible="wizard_state == 'weight' or not product_tracking"
                            options="{'no_create': True}"
                            nolabel="1"
                        />
                    </group>
                    <field
                        name="weight"
                        nolabel="1"
                        default_focus="1"
                        widget="numeric_step"
                        class="w-100 text-center text-info o_input_weight"
                        options="{'auto_select': True, 'min': 0}"
                    />
                    <group groups="stock.group_tracking_lot">
                        <field
                            name="result_package_id"
                            class="form-control-lg ps-0"
                            placeholder="Select destination package..."
                            invisible="wizard_state == 'weight'"
                            options="{'no_open': True, 'no_create': True}"
                            nolabel="1"
                        />
                    </group>
                    <footer>
                        <button
                            name="record_weight"
                            type="object"
                            class="btn btn-primary"
                            invisible="wizard_state != 'weight'"
                            data-hotkey="r"
                        >Record</button>
                        <button
                            name="add_operation_and_record"
                            type="object"
                            class="btn btn-primary"
                            invisible="wizard_state == 'weight'"
                            data-hotkey="r"
                        >Add detailed operation</button>
                        <button
                            name="add_operation_and_record"
                            type="object"
                            class="btn btn-secondary default-enter"
                            invisible="wizard_state == 'weight'"
                            data-hotkey="s"
                            context="{'reload_wizard_action': True}"
                        >Add detailed operation and new weighing</button>
                        <button
                            string="Cancel"
                            class="btn-secondary"
                            type="object"
                            name="action_close"
                            data-hotkey="z"
                        />
                        <field name="print_label" widget="boolean_toggle" />
                        <label for="print_label" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
    <record id="weighing_wizard_action" model="ir.actions.act_window">
        <field name="res_model">weighing.wizard</field>
        <field name="name">Record Weight</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="view_id" ref="weighing_wizard_form_view" />
        <field name="target">new</field>
    </record>
</odoo>
