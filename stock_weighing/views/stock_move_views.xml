<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- A kanban with no borders so the usability is more like a tree -->
    <record id="view_move_weight_kanban_view" model="ir.ui.view">
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <!-- <kanban class="o_weight_kanban" js_class="base_weight_record_kanban" create="0" group_create="0" group_delete="0" group_edit="0" records_draggable="0" groups_draggable="0" quick_create="0"> -->
            <kanban
                highlight_color="weighing_state_color"
                js_class="base_weight_record_kanban"
                class="o_weight_kanban"
                create="0"
                can_open="0"
                group_create="0"
                group_delete="0"
                group_edit="0"
                records_draggable="0"
                groups_draggable="0"
                quick_create="0"
                limit="80"
            >
                <field name="id" />
                <field name="product_id" />
                <field name="show_details_visible" />
                <field name="product_uom_qty" />
                <field name="product_qty" readonly="1" />
                <field name="quantity" />
                <field name="recorded_weight" />
                <field name="is_inventory" />
                <field name="state" />
                <field name="uom_id" />
                <field name="captured_quantity" />
                <field name="location_id" />
                <field name="location_dest_id" />
                <field name="has_weight" />
                <field name="reference" />
                <field name="move_line_ids" />
                <field name="move_lines_count" />
                <field name="move_lines_weighed" />
                <field name="weighing_state" />
                <field name="capture_user_id" />
                <field name="is_capture_locked" />
                <field name="show_weighing_print_button" />
                <field name="partner_id" />
                <field name="capture_location_names" />
                <field name="weighing_label_report_id" />
                <field name="date" />
                <progressbar
                    field="weighing_state"
                    colors='{"weighed": "success", "to_weigh": "danger", "weighing": "warning"}'
                />
                <templates>
                    <t t-name="card">
                        <t
                            t-set="single_move_line"
                            t-value="record.move_lines_count.raw_value === 1"
                        />
                        <div
                            t-attf-class="o_weight_kanban_card {{record.is_capture_locked.raw_value and 'bg-light' or ''}}"
                        >
                            <div class="o_kanban_detail_ungrouped row">
                                <!-- Header infos -->
                                <div class="col-12">
                                    <div name="weight_card_header" class="mb-2">
                                        <t t-if="record.capture_lot_names.raw_value">
                                            <small>LOTS: </small>
                                            <span class="text-muted me-1">
                                                <field name="capture_lot_names" />
                                            </span>
                                        </t>
                                        <span
                                            class="badge bg-light me-1"
                                            title="Destination"
                                        >
                                            <t
                                                t-out="record.capture_location_names.value"
                                            />
                                            <i class="oi" data-icon="arrow_forward" />
                                            <t t-out="record.location_dest_id.value" />
                                        </span>
                                        <span class="pull-right badge bg-light">
                                            <field name="date" />
                                        </span>
                                        <span
                                            t-if="record.is_capture_locked.raw_value"
                                            class="badge bg-danger pull-right"
                                            title="Locked by user"
                                        >
                                            <i class="oi" data-icon="lock" />
                                            <field name="capture_user_id" />
                                        </span>
                                    </div>
                                </div>
                                <!-- Informations -->
                                <div class="col-5 o_weight_name">
                                    <strong class="h5 mb-0">
                                        <field name="product_id" />
                                    </strong>
                                    <div class="mt-1">
                                        <span
                                            class="badge bg-primary text-light h4 me-1"
                                            t-out="record.reference.raw_value"
                                        />
                                        <em t-out="record.partner_id.value" />
                                    </div>
                                    <div class="mt-1">
                                        <span class="text-warning">
                                            <strong>To do: </strong>
                                            <field name="product_uom_qty" />
                                            <field name="uom_id" />
                                        </span>
                                        <span class="text-info ms-2">
                                            <strong>Reserved: </strong>
                                            <field name="quantity" />
                                            <field name="uom_id" />
                                        </span>
                                        <span class="ms-2 text-success">
                                            <strong>Done: </strong>
                                            <field name="captured_quantity" />
                                            <field name="uom_id" />
                                        </span>
                                    </div>
                                </div>
                                <!-- Recording button -->
                                <div class="col-1">
                                    <div
                                        t-if="!['done', 'cancel', 'draft'].includes(record.state.raw_value)"
                                        class="d-flex flex-column flex-xl-row align-items-center gap-2"
                                    >
                                        <button
                                            t-if="record.move_lines_count.raw_value === 1"
                                            class="btn btn-lg border"
                                            string="Record weight"
                                            name="action_weighing"
                                            type="object"
                                        >
                                            <i
                                                class="oi"
                                                t-attf-class="{{record.recorded_weight.raw_value ? 'text-success' : 'oi-filled text-danger'}}"
                                                t-att-data-icon="record.recorded_weight.raw_value ? 'refresh' : 'circle'"
                                            />
                                        </button>
                                        <!-- We can't do a t-attf-name -->
                                        <button
                                            t-elif="record.move_lines_count.raw_value &gt; 1 &amp;&amp; !context.hide_weight_detail_buttons"
                                            class="btn btn-lg border"
                                            string="Record weight"
                                            name="action_weight_detailed_operations"
                                            type="object"
                                        >
                                            <i
                                                class="oi"
                                                t-attf-class="{{record.recorded_weight.raw_value &amp;&amp; record.weighing_state.raw_value == 'weighed' ? 'text-success' : 'oi-filled text-danger'}}"
                                                t-att-data-icon="record.recorded_weight.raw_value &amp;&amp; record.weighing_state.raw_value == 'weighed' ? 'refresh' : 'circle'"
                                            />
                                        </button>
                                        <button
                                            t-elif="record.move_lines_count.raw_value &gt; 1 &amp;&amp; context.hide_weight_detail_buttons &amp;&amp; record.weighing_state.raw_value === 'weighing'"
                                            class="btn btn-lg border"
                                            string="Force weighed"
                                            title="Force weighed"
                                            name="action_force_weighed"
                                            type="object"
                                        >
                                            <i
                                                class="oi text-success"
                                                data-icon="check"
                                            />
                                        </button>
                                        <button
                                            t-if="!record.has_weight.raw_value and record.quantity.raw_value !== record.captured_quantity.raw_value"
                                            class="btn btn-lg border"
                                            string="Set reserved to done"
                                            title="Set reserved to done"
                                            name="set_product_uom_qty_to_qty_done_from_weighing"
                                            type="object"
                                        >
                                            <i
                                                class="oi text-success"
                                                data-icon="arrow_forward"
                                            />
                                        </button>
                                    </div>
                                </div>
                                <!-- Weight -->
                                <div class="col-2">
                                    <span
                                        t-if="record.weighing_state.raw_value === 'weighed'"
                                        class="badge w-100 bg-success"
                                    >Weighed</span>
                                    <span
                                        t-elif="record.weighing_state.raw_value === 'weighing'"
                                        class="bg-warning w-100 badge"
                                    >Weighing</span>
                                    <span
                                        t-elif="record.weighing_state.raw_value === 'to_weigh'"
                                        class="badge bg-danger w-100"
                                    >To weigh</span>
                                    <span
                                        t-else=""
                                        t-attf-class="badge bg-{{record.recorded_weight.raw_value ? 'success' : 'light'}} w-100"
                                    >Qty. done</span>
                                    <div class="text-center">
                                        <t t-if="record.captured_quantity.raw_value">
                                            <span class="h1 text-success">
                                                <field name="captured_quantity" />
                                            </span>
                                            <sup class="initialism">
                                                <field name="uom_id" />
                                            </sup>
                                        </t>
                                        <t t-else="">
                                            <span
                                                class="h1 text-warning"
                                                t-out="'--.--'"
                                            />
                                        </t>
                                    </div>
                                </div>
                                <!-- Extra buttons -->
                                <div class="col-3">
                                    <div>
                                        <!-- Hidden for the moment -->
                                        <button
                                            t-if="!['done', 'cancel', 'draft'].includes(record.state.raw_value)"
                                            class="btn btn-secondary btn-lg"
                                            type="object"
                                            name="action_add_move_line"
                                            title="Add operation"
                                        >
                                            <i class="oi" data-icon="add" />
                                        </button>
                                        <button
                                            t-if="!['done', 'cancel', 'draft'].includes(record.state.raw_value)"
                                            class="ms-1 btn btn-secondary btn-lg"
                                            type="object"
                                            name="action_reset_weights"
                                            title="Reset weights"
                                            confirm="This will reset your current weight. Proceed?"
                                        >
                                            <i class="oi" data-icon="close" />
                                        </button>
                                        <button
                                            t-if="record.is_capture_locked.raw_value"
                                            class="ms-1 btn-danger btn btn-lg"
                                            type="object"
                                            name="action_unlock_weigh_operation"
                                            title="Unlock weight operation"
                                        >
                                            <i class="oi" data-icon="lock" />
                                        </button>
                                        <button
                                            t-if="record.show_weighing_print_button.raw_value"
                                            class="btn btn-lg btn-secondary ms-2"
                                            name="action_print_weight_record_label"
                                            type="object"
                                            string="Print labels"
                                            title="Print labels"
                                            context="{'launch_manual_print': True}"
                                        >
                                            <i class="oi" data-icon="print" />
                                        </button>
                                    </div>
                                </div>
                                <!-- Details -->
                                <div class="col-1">
                                    <div>
                                        <button
                                            t-if="(!single_move_line &amp;&amp; !context.hide_weight_detail_buttons) || context.show_weight_detail_buttons"
                                            t-attf-class="btn btn-lg {{single_move_line ? 'btn-secondary' : 'btn-primary'}}"
                                            type="object"
                                            name="action_weight_detailed_operations"
                                            title="Details"
                                        >
                                            <i
                                                class="oi"
                                                data-icon="view_list"
                                                title="Details"
                                            />
                                        </button>
                                    </div>
                                </div>
                                <!-- Footer infos-->
                                <div class="col-12">
                                    <div name="weight_card_footer" class="mt-2">
                                        <span
                                            class="badge bg-light"
                                            t-out="record.state.value"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!-- This is meant to be used in a split view if we get to do that instead of the wizard approach -->
    <record id="stock_move_weight_form_view" model="ir.ui.view">
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <form class="weighing_detail_form" create="0" edit="0">
                <field name="company_id" invisible="1" />
                <!-- HACK: Use the same kanban in the form view with a computed field on itself so we can reuse it -->
                <field
                    name="self_move_ids"
                    mode="kanban"
                    class="w-100"
                    context="{'kanban_view_ref': 'stock_weighing.view_move_weight_kanban_view', 'hide_weight_detail_buttons': True}"
                />
                <field
                    name="move_line_ids"
                    mode="kanban"
                    class="w-100"
                    context="{'kanban_view_ref': 'stock_weighing.stock_move_line_weight_kanban_view'}"
                />
            </form>
        </field>
    </record>
    <record id="view_move_search" model="ir.ui.view">
        <field name="model">stock.move</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="stock.view_move_search" />
        <field name="arch" type="xml">
            <filter name="inventory" position="after">
                <filter
                    string="Weight"
                    name="weighed"
                    domain="[('has_weight', '=', True)]"
                />
            </filter>
            <filter name="ready" position="attributes">
                <attribute
                    name="context"
                >{'shown_in_panel': {'icon': 'thumb_up'}}</attribute>
                <attribute name="domain">[('state','=','assigned')]</attribute>
            </filter>
            <filter name="future" position="attributes">
                <attribute
                    name="context"
                >{'shown_in_panel': {'icon': 'arrow_forward'}}</attribute>
            </filter>
            <filter name="done" position="after">
                <separator />
                <filter
                    string="To weigh"
                    name="to_weigh"
                    domain="[('weighing_state', 'in', ['weighing', 'to_weigh'])]"
                    context="{'shown_in_panel': {'icon': 'device_thermostat'}}"
                />
            </filter>
            <filter name="today" position="before">
                <filter
                    string="Today"
                    name="date_today"
                    domain="[('date', '&lt;=', context_today().strftime('%%Y-%%m-%%d 23:59:59'))]"
                    context="{'shown_in_panel': {'icon': 'calendar_today'}}"
                />
            </filter>

            <filter name="status" position="after">
                <filter
                    string="Weighing State"
                    name="weighing_state"
                    domain="[]"
                    context="{'group_by': 'weighing_state'}"
                />
                <filter
                    string="Destination"
                    name="destination_address"
                    domain="[]"
                    context="{'group_by': 'partner_id'}"
                />
            </filter>
        </field>
    </record>
    <!-- Default action -->
    <record id="weighing_operation_action" model="ir.actions.act_window">
        <field name="res_model">stock.move</field>
        <field name="name">Weighing operations</field>
        <field name="view_mode">kanban,form</field>
        <field
            name="context"
        >{'search_default_ready': 1, 'search_default_date_today': 1, 'outgoing_weighing_order': 1}</field>
        <field name="domain">[('has_weight', '=', True)]</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),(0, 0, {'view_mode': 'kanban', 'view_id': ref('stock_weighing.view_move_weight_kanban_view')}),(0, 0, {'view_mode': 'form', 'view_id': ref('stock_weighing.stock_move_weight_form_view')})]"
        />
        <field name="search_view_id" ref="stock_weighing.view_move_search" />
        <field name="path">weighing</field>
    </record>
</odoo>
