<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_move_line_weight_kanban_view" model="ir.ui.view">
        <field name="model">stock.move.line</field>
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <kanban class="o_weight_kanban">
                <field name="product_id" />
                <field name="quantity" />
                <field name="location_id" invisible="1" />
                <field name="location_dest_id" invisible="1" />
                <field name="has_weight" />
                <field name="has_recorded_weight" />
                <field name="picked" />
                <field name="recorded_weight" />
                <field name="state" />
                <field name="reference" />
                <field name="tracking" />
                <templates>
                    <t t-name="card">
                        <div class="o_weight_kanban_card">
                            <div class="o_kanban_detail_ungrouped row">
                                <div class="col-12">
                                    <div>
                                        <span class="badge bg-light">
                                            <field name="location_id" />
                                            <i
                                                class="oi"
                                                data-icon="arrow_forward"
                                                title="to"
                                            />
                                            <field name="location_dest_id" />
                                        </span>
                                    </div>
                                </div>
                                <!-- Infos -->
                                <div class="col-2">
                                    <div>
                                        <span>To weigh:</span>
                                        <br />
                                        <strong class="h5 text-warning">
                                            <field name="quantity" />
                                            <field name="uom_id" />
                                        </strong>
                                    </div>
                                </div>
                                <div class="col-2 o_weight_name">
                                    <t t-if="record.tracking.raw_value">
                                        <small>LOT</small>
                                        <span
                                            t-if="record.lot_id.raw_value"
                                            class="h4 text-muted"
                                        >
                                            <field name="lot_id" />
                                        </span>
                                        <span t-else="" class="h4 text-muted">
                                            <field name="lot_name" />
                                        </span>
                                    </t>
                                    <t
                                        groups="stock.group_tracking_lot"
                                        t-if="record.result_package_id.raw_value"
                                    >
                                        <small>Dest. Package</small>
                                        <span class="h4 text-muted">
                                            <field name="result_package_id" />
                                        </span>
                                    </t>
                                </div>
                                <!-- Weight -->
                                <!-- Recording button -->
                                <div class="col-2">
                                    <div t-if="record.state.raw_value !== 'done'">
                                        <button
                                            string="Record weight"
                                            name="action_weighing"
                                            type="object"
                                            class="btn btn-lg border"
                                        >
                                            <i
                                                class="oi"
                                                t-attf-class="{{record.recorded_weight.raw_value ? 'text-success' : 'oi-filled text-danger'}}"
                                                t-att-data-icon="record.recorded_weight.raw_value ? 'refresh' : 'circle'"
                                            />
                                        </button>
                                    </div>
                                </div>
                                <!-- Weight value -->
                                <div class="col-3">
                                    <div>
                                        <t t-if="record.picked.raw_value">
                                            <span class="h1 text-success">
                                                <field name="quantity" />
                                            </span>
                                            <sup class="initialism">
                                                <field name="uom_id" />
                                            </sup>
                                        </t>
                                        <t t-else="">
                                            <span
                                                class="h1 text-warning"
                                                t-out="'--.--'"
                                            />
                                        </t>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div>
                                        <button
                                            t-if="!['done', 'cancel', 'draft'].includes(record.state.raw_value)"
                                            class="btn btn-secondary btn-lg"
                                            type="object"
                                            name="action_reset_weights"
                                            title="Reset weights"
                                            confirm="This will reset your current weight. Proceed?"
                                        >
                                            <i class="oi" data-icon="close" />
                                        </button>
                                        <button
                                            class="btn btn-lg btn-secondary ms-2"
                                            name="action_print_weight_record_label"
                                            type="object"
                                            string="Print labels"
                                            title="Print labels"
                                            context="{'launch_manual_print': True}"
                                        >
                                            <i
                                                class="oi"
                                                data-icon="print"
                                                role="img"
                                            />
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
