<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="weighing_operations" invisible="1" />
                <field name="has_weighing_operations" invisible="1" />
                <button
                    name="action_weighing_operations"
                    string="Weight"
                    type="object"
                    class="oe_stat_button"
                    icon="device_thermostat"
                    invisible="(not has_weighing_operations) or (state in ['draft', 'cancel'])"
                />
            </div>
        </field>
    </record>
    <record id="mrp_production_card_view" model="ir.ui.view">
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_card_view" />
        <field name="arch" type="xml">
            <field name="reservation_state" position="after">
                <field name="has_weighing_operations" />
            </field>
            <xpath expr="//footer//field[@name='user_id']" position="before">
                <button
                    t-if="record.has_weighing_operations.raw_value"
                    class="btn btn-sm btn-primary"
                    name="action_weighing_operations"
                    type="object"
                    title="Weighings"
                >
                    <i class="oi" data-icon="device_thermostat" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
