<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="stock_weighing_remote_measure.RemoteMeasureForm">
        <div t-if="this.hasDevice" class="container">
            <div class="row">
                <div class="col-12 border-dark p-2 rounded border ms-0" name="display">
                    <div
                        t-if="this.measureState.tares.length or this.measureState.can_configure_tares"
                        class="text-start ms-1 text-info me-1 w-100"
                        name="tare_infos"
                    >
                        TARE:
                        <span
                        name="tare_amount"
                        class="fw-bold text-danger"
                        t-out="this.formatFloat(this.measureState.tare)"
                    />
                        <span class="text-danger me-1" t-out="this.uomName" />
                        REAL:
                        <span
                        name="real_amount"
                        class="text-success fw-bold"
                        t-out="this.formatFloat(this.measureState.input_val)"
                    />
                        <span class="text-success" t-out="this.uomName" />
                        <div
                        class="text-dark d-inline float-end"
                        title="Device info"
                        name="device_selector"
                        role="button"
                        t-on-click.prevent="this.onDeviceSelector"
                    >
                        <i class="oi me-1" data-icon="device_thermostat" />
                        <span t-out="this.measureState.device_name" />
                    </div>
                    </div>
                    <div
                        name="weight_control"
                        class="d-flex justify-content-around align-items-center w-100"
                    >
                        <span
                            t-if="this.measureState.stop"
                            class="o_field_remote_device_start btn btn-primary btn-lg"
                            title="Measure"
                            t-on-click.prevent="this.onMeasure"
                        >
                            <i class="oi" data-icon="device_thermostat" role="img" />
                        </span>
                        <span
                            t-else=""
                            class="o_field_remote_device_stop btn btn-lg"
                            t-att-class="this.measureState.class"
                            title="Validate the measure"
                            t-on-click.prevent="this.onValidateMeasure"
                        >
                            <i
                                class="oi"
                                t-att-class="{'opacity-50': this.measureState.tick}"
                                data-icon="device_thermostat"
                                role="img"
                            />
                        </span>
                        <span
                            t-if="this.measureState.additive_measure"
                            class="o_field_remote_device_start btn btn-link btn-sm"
                            title="Add a measure"
                            t-on-click.prevent="this.onMeasureAdd"
                        >
                            <i class="oi" data-icon="add" role="img" />
                        </span>
                        <input
                            t-att-id="this.props.id"
                            class="o_input border-0"
                            t-on-focusin="this.onFocusIn"
                            t-on-focusout="this.onFocusOut"
                            t-ref="this.numpadDecimalRef"
                            t-att-placeholder="this.props.placeholder"
                            t-att-type="this.props.inputType"
                            inputmode="decimal"
                            autocomplete="off"
                            t-att-step="this.props.step"
                        />
                    </div>
                </div>
                <div class="pt-2 col-12 ps-0 pe-0" name="buttons">
                    <div
                        t-foreach="this.measureState.tares"
                        t-as="tare"
                        t-key="tare_index"
                        class="btn-group mb-2 float-start me-2 btn-group-lg"
                    >
                        <t
                            t-set="color"
                            t-value="this.colors[tare_index % this.colors.length]"
                        />
                        <t
                            t-set="tare_style"
                            t-value="tare.color ? '--tare-color: ' + tare.color + '; --tare-text-color: ' + (tare.text_color || '#FFFFFF') : undefined"
                        />
                        <button
                            class="btn"
                            t-att-class="tare.color ? 'btn-tare-outline' : 'btn-outline-' + color"
                            t-att-style="tare_style"
                            type="button"
                            t-on-click.prevent="() => this.onClickTare(tare.tare)"
                        >-</button>
                        <button
                            class="btn disabled"
                            t-att-class="tare.color ? 'btn-tare' : 'btn-' + color"
                            t-att-style="tare_style"
                            type="button"
                        >
                            <t t-if="tare.name" t-out="tare.name" />
                            <t t-else="">
                                <t t-out="tare.tare" />
                                <t t-out="this.uomName" />
                            </t>
                        </button>
                        <button
                            class="btn"
                            t-att-class="tare.color ? 'btn-tare-outline' : 'btn-outline-' + color"
                            t-att-style="tare_style"
                            type="button"
                            t-on-click.prevent="() => this.onClickTare(-tare.tare)"
                        >+</button>
                    </div>
                    <button
                        t-if="this.measureState.can_configure_tares"
                        class="btn btn-lg btn-outline-dark float-end mb-2"
                        name="configure_tares"
                        type="button"
                        title="Configure tares"
                        aria-label="Configure tares"
                        t-on-click.prevent="this.onConfigureTares"
                    >
                        <i class="oi oi-filled" data-icon="settings" />
                    </button>
                </div>
                <div class="pt-2 col-12 ps-0">
                    <div name="manual_tare" class="input-group input-group-lg">
                        <span
                            class="input-group-text text-uppercase manual_tare_label"
                        >Manual tare</span>
                        <button
                            class="btn btn-primary"
                            aria-label="Minus"
                            title="Minus"
                            type="button"
                            data-mode="plus"
                            t-on-click.prevent="this.onClickManualTare"
                        >
                            <i class="oi" data-icon="remove" />
                        </button>
                        <input
                            type="number"
                            step="0.1"
                            inputmode="decimal"
                            class="form-control text-center"
                            aria-label="Manual tare"
                            t-on-change="this.onChangeTareManualTare"
                        />
                        <button
                            class="btn btn-primary"
                            aria-label="Plus"
                            title="Plus"
                            type="button"
                            data-mode="minus"
                            t-on-click.prevent="this.onClickManualTare"
                        >
                            <i class="oi" data-icon="add" />
                        </button>
                        <span class="input-group-text" t-out="this.uomName" />
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
