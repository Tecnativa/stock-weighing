<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="stock_weighing_remote_measure.DeviceDialog">
        <Dialog size="'md'" footer="false" title.translate="Choose a device">
            <div>
                <button
                    t-foreach="this.devices"
                    t-as="device"
                    t-key="device.id"
                    class="btn btn-dark w-100 mb-2"
                    t-on-click.prevent="() => this.onClickDevice(device)"
                    t-out="device.name"
                />
            </div>
        </Dialog>
    </t>
</templates>
