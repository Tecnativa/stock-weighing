<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="web_widget_remote_measure.RemoteMeasureField">
        <span t-if="this.props.readonly" t-out="this.formattedValue" />
        <t t-else="">
            <t t-if="this.hasDevice">
                <span
                    t-if="this.measureState.stop"
                    class="o_field_remote_device_start btn btn-primary btn-sm"
                    title="Measure"
                    t-on-click.prevent="this.onMeasure"
                >
                    <i class="oi" data-icon="device_thermostat" role="img" />
                </span>
                <span
                    t-else=""
                    class="o_field_remote_device_stop btn btn-sm"
                    t-att-class="this.measureState.class"
                    title="Validate the measure"
                    t-on-click.prevent="this.onValidateMeasure"
                >
                    <i
                        class="oi"
                        t-att-class="{'opacity-50': this.measureState.tick}"
                        data-icon="device_thermostat"
                        role="img"
                    />
                </span>
                <span
                    t-if="this.measureState.additive_measure"
                    class="o_field_remote_device_start btn btn-link btn-sm"
                    title="Add a measure"
                    t-on-click.prevent="this.onMeasureAdd"
                >
                    <i class="oi" data-icon="add" role="img" />
                </span>
            </t>
            <input
                t-on-focusin="this.onFocusIn"
                t-on-focusout="this.onFocusOut"
                t-att-id="this.props.id"
                t-ref="this.numpadDecimalRef"
                t-att-placeholder="this.props.placeholder"
                t-att-type="this.props.inputType"
                inputmode="decimal"
                class="o_input"
                autocomplete="off"
                t-att-step="this.props.step"
            />
        </t>
    </t>
</templates>
